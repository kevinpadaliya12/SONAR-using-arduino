import serial
import pygame
import math
import time

# --- Setup Serial Communication ---
# You need to change 'COM5' to the correct port for your Arduino
# and match the baud rate (9600) with the Arduino code.
try:
    ser = serial.Serial('COM5', 9600, timeout=1)
    time.sleep(2)  # Give time for the connection to establish
except serial.SerialException as e:
    print(f"Error: Could not open serial port. Check if the Arduino is connected and the port name is correct. {e}")
    exit()

# --- Pygame Setup ---
pygame.init()

# Define colors
GREEN = (98, 245, 31)
RED = (255, 10, 10)
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)

# Screen dimensions
width, height = 1200, 700
screen = pygame.display.set_mode((width, height))
pygame.display.set_caption("Python Sonar Radar")
clock = pygame.time.Clock()

# Radar constants
RADAR_CENTER_X = width // 2
RADAR_CENTER_Y = height - int(height * 0.074)
RADAR_RADIUS = width - width * 0.505  # Approximate radius for the furthest circle

# Font setup
font = pygame.font.Font(None, 25)

# Variables to hold sensor data
iAngle = 0
iDistance = 0
angle_history = {} # A dictionary to store detected objects

def draw_radar_components():
    """Draws the static parts of the radar GUI."""
    screen.fill(BLACK) # Clear screen

    # Draw radar circles
    pygame.draw.arc(screen, GREEN, (RADAR_CENTER_X - (width-width*0.0625)/2, RADAR_CENTER_Y - (width-width*0.0625)/2, width-width*0.0625, width-width*0.0625), math.pi, 2 * math.pi, 2)
    pygame.draw.arc(screen, GREEN, (RADAR_CENTER_X - (width-width*0.27)/2, RADAR_CENTER_Y - (width-width*0.27)/2, width-width*0.27, width-width*0.27), math.pi, 2 * math.pi, 2)
    pygame.draw.arc(screen, GREEN, (RADAR_CENTER_X - (width-width*0.479)/2, RADAR_CENTER_Y - (width-width*0.479)/2, width-width*0.479, width-width*0.479), math.pi, 2 * math.pi, 2)
    pygame.draw.arc(screen, GREEN, (RADAR_CENTER_X - (width-width*0.687)/2, RADAR_CENTER_Y - (width-width*0.687)/2, width-width*0.687, width-width*0.687), math.pi, 2 * math.pi, 2)

    # Draw radial lines
    for angle_deg in range(15, 180, 30):
        angle_rad = math.radians(angle_deg)
        end_x = RADAR_CENTER_X + RADAR_RADIUS * math.cos(angle_rad)
        end_y = RADAR_CENTER_Y - RADAR_RADIUS * math.sin(angle_rad)
        pygame.draw.line(screen, GREEN, (RADAR_CENTER_X, RADAR_CENTER_Y), (end_x, end_y), 2)

def draw_sweep_line(angle_deg):
    """Draws the rotating sweep line."""
    angle_rad = math.radians(angle_deg)
    line_end_x = RADAR_CENTER_X + RADAR_RADIUS * math.cos(angle_rad)
    line_end_y = RADAR_CENTER_Y - RADAR_RADIUS * math.sin(angle_rad)
    pygame.draw.line(screen, GREEN, (RADAR_CENTER_X, RADAR_CENTER_Y), (line_end_x, line_end_y), 3)

def draw_objects():
    """Draws detected objects based on the stored history."""
    for angle, distance in angle_history.items():
        if distance < 40: # Only draw if in range
            # Convert distance from cm to pixels
            pixsDistance = distance * ((height - height * 0.1666) * 0.025)
            
            angle_rad = math.radians(angle)
            obj_x = RADAR_CENTER_X + pixsDistance * math.cos(angle_rad)
            obj_y = RADAR_CENTER_Y - pixsDistance * math.sin(angle_rad)
            pygame.draw.circle(screen, RED, (int(obj_x), int(obj_y)), 5)

def update_gui(angle, distance):
    """Updates the GUI with new data."""
    global iAngle, iDistance, angle_history
    iAngle = angle
    iDistance = distance

    if iDistance < 40:
        angle_history[iAngle] = iDistance
    else:
        if iAngle in angle_history:
            del angle_history[iAngle]

    draw_radar_components()
    draw_objects()
    draw_sweep_line(iAngle)

# --- Main Program Loop ---
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    try:
        data = ser.readline().decode('utf-8').strip()
        if data:
            parts = data.split(',')
            if len(parts) == 2:
                angle_str = parts[0]
                distance_str = parts[1].strip('.')
                try:
                    current_angle = int(angle_str)
                    current_distance = int(distance_str)
                    update_gui(current_angle, current_distance)
                except ValueError:
                    continue # Skip invalid data
    except serial.SerialException:
        print("Lost connection to Arduino.")
        running = False
    except Exception as e:
        print(f"An error occurred: {e}")

    pygame.display.flip()
    clock.tick(60) # Set FPS

pygame.quit()
ser.close()
